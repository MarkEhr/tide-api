{
  "name": "tide-api",
  "version": "2.0.0",
  "description": "Modern, type-safe TypeScript library for consuming REST APIs with interceptors, plugins, and a beautiful proxy-based interface",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run type-check && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkEhr/tide-api.git"
  },
  "keywords": [
    "api",
    "rest",
    "http",
    "fetch",
    "client",
    "typescript",
    "interceptors",
    "plugins",
    "proxy",
    "type-safe"
  ],
  "author": "Mark Ehrlich",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MarkEhr/tide-api/issues"
  },
  "homepage": "https://github.com/MarkEhr/tide-api#readme",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^1.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "redux": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "redux": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
